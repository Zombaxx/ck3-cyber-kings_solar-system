pdxmesh = {
	name = "male_cyber_eyes_mesh"
	file = "male_cyber_eyes.mesh"
	streaming = Never

	meshsettings = {
		name = "male_eyesShape"
		index = 0
		texture_diffuse = "cyber_eyes_cywizard_diffuse.dds"
		texture_normal = "cyber_eyes_normal.dds"
		texture_specular = "cyber_eyes_cywizard_properties.dds"
		texture = { file = "cyber_eyes_ssao_color.dds" index = 3 }
		shader = "portrait_eye"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

