# Cyber Kings map table (paper-map surround): painted planes at different depths. Generated by
# _dev/scripts/map_table/ (gen_table_a.py, gen_table_b.py) - change the scripts, not these files.
# Light maps (index 7): RGB = baked light (BAKED_LIGHTING), A = 0.5 neutral .. 1.0 = x2 glow (LIGHTING_DECAL).

# ---- A. Command Deck: holo-table console ring + deck floor far below
pdxmesh = {
	name = "ck_deck_table_mesh"
	file = "ck_deck_table.mesh"
	cull_distance = 100000
	meshsettings = {
		name = "ck_deck_tableShape"
		index = 0
		texture_diffuse = "ck_deck_table_diffuse.dds"
		texture_normal = "ck_flat_normal.dds"
		texture_specular = "ck_metal_properties.dds"
		shader = "standard_map_decoration_alpha_to_coverage"
		shader_file = "gfx/FX/pdxmesh.shader"
		texture = { file = "ck_deck_table_light.dds" index = 7 }
		additional_shader_defines = { "BAKED_LIGHTING" "LIGHTING_DECAL" }
	}
}
entity = { name = "ck_deck_table_entity" pdxmesh = "ck_deck_table_mesh" }

pdxmesh = {
	name = "ck_deck_floor_mesh"
	file = "ck_deck_floor.mesh"
	cull_distance = 100000
	meshsettings = {
		name = "ck_deck_floorShape"
		index = 0
		texture_diffuse = "ck_deck_floor_diffuse.dds"
		texture_normal = "ck_flat_normal.dds"
		texture_specular = "ck_matte_properties.dds"
		shader = "map_floor"
		shader_file = "gfx/FX/pdxmesh.shader"
		texture = { file = "ck_deck_floor_light.dds" index = 7 }
		additional_shader_defines = { "BAKED_LIGHTING" "LIGHTING_DECAL" }
	}
}
entity = { name = "ck_deck_floor_entity" pdxmesh = "ck_deck_floor_mesh" }

